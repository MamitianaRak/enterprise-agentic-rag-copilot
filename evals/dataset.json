      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["9:00", "9 am", "9am"], ["6:00", "6 pm", "6pm"], ["1-hour", "one-hour", "1 hour", "one hour"]]
      }
    },
    {
      "id": "hr-payroll-dates", "domain": "hr", "kind": "answer",
      "question": "When is salary paid, and how long do I have to report a mistake on my payslip?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["final business day", "last business day", "last working day", "final working day"], ["5 business days", "five business days"]]
      }
    },
    {
      "id": "hr-benefits-change", "domain": "hr", "kind": "answer",
      "question": "Can I change my benefits enrollment in the middle of the year?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["qualifying life event"], ["supporting documentation", "supporting documents", "documentation"]]
