      "id": "it-password-length", "domain": "it", "kind": "answer",
      "question": "What is the minimum length for my company password?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_it_handbook.md"],
        "facts": [["14 characters", "14-character", "fourteen"]]
      }
    },
    {
      "id": "it-mfa-methods", "domain": "it", "kind": "answer",
