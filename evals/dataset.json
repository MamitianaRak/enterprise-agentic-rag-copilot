    {
      "id": "hr-harassment", "domain": "hr", "kind": "answer",
      "question": "Where should I report harassment by a colleague?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["manager"], ["hr"], ["ethics"]]
      }
    },
    {
      "id": "hr-payroll-priority", "domain": "hr", "kind": "answer",
      "question": "An employee has not received their salary this month. What priority should HR give it?",
      "expect": {
        "sources": ["private_kb"], "documents": ["hr_operations_runbook.md"],
        "facts": [["p2"]]
      }
    },
    {
      "id": "hr-bank-details", "domain": "hr", "kind": "answer",
      "question": "How do I update my bank details for payroll?",
