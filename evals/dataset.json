{
  "name": "enterprise-copilot-eval",
  "version": 1,
  "description": "Questions with answers taken from data/documents. facts: every group must appear in the answer (any one phrase of the group, case-insensitive). forbidden: phrases that must not appear unless negated ('do not disable the firewall' is fine). sources: accepted final source_used values.",
  "cases": [
    {
      "id": "hr-annual-leave", "domain": "hr", "kind": "answer",
      "question": "How many days of paid annual leave do I get, and can I carry unused days into next year?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["20 days", "20 paid", "twenty"], ["5 days", "five days", "up to 5"], ["march 31", "31 march", "end of march"]]
      }
    },
    {
      "id": "hr-sick-leave", "domain": "hr", "kind": "answer",
      "question": "How many paid sick days do we have, and when can HR ask for a medical certificate?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["10 paid sick", "10 sick", "10 days", "ten"], ["2 consecutive", "two consecutive", "more than 2", "longer than 2", "more than two", "longer than two"]]
      }
    },
    {
      "id": "hr-remote-work", "domain": "hr", "kind": "answer",
      "question": "Can I work from home, and how often?",
      "expect": {
        "sources": ["private_kb"], "documents": ["company_hr_handbook.md"],
        "facts": [["2 days", "two days"], ["manager approval", "approval from your manager", "manager's approval", "manager must approve", "approved by your manager", "your manager approves"]]
      }
    },
    {
      "id": "hr-working-hours", "domain": "hr", "kind": "answer",
