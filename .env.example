# --- LLM gateway (LiteLLM Router) ---
# At least one provider key. Each lane tries its providers in order; a provider that is
# rate-limited or down is put in cooldown and the next one answers. Providers without a key are skipped.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare Workers AI (optional, OpenAI-compatible endpoint)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# answer lane writes the answers; fast lane runs the JSON steps (triage, grading, rewrites, checks)
LLM_PROVIDERS=gemini,groq,cloudflare,openrouter
LLM_FAST_PROVIDERS=groq,cloudflare,gemini,openrouter
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT=60
# Seconds a failing provider is skipped before being tried again
LLM_COOLDOWN_SECONDS=60
# In-memory cache of identical prompts (exact match, never written to disk); 0 disables it
LLM_CACHE_TTL_SECONDS=3600

# --- Embeddings (Pinecone Inference, uses PINECONE_API_KEY) ---
EMBEDDING_MODEL=llama-text-embed-v2
# Must match the dimension of the Pinecone index
EMBEDDING_DIMENSION=768

# --- Vector store (Pinecone) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-copilot
HR_NAMESPACE=company-hr-kb
CLOUDOPS_NAMESPACE=cloudops-runbooks
IT_NAMESPACE=it-support-kb

# --- Web fallback (Tavily) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- App ---
ADMIN_API_KEY=change-me-in-production
APP_ENV=development
# Origins allowed to call the API from a browser when the frontend is hosted separately
# (comma-separated, e.g. https://enterprise-copilot.onrender.com). Leave empty locally.
CORS_ORIGINS=
TOP_K=6
MAX_RETRIES=1
MAX_SUPPORT_RETRIES=1
# CloudOps: internal query rewrites before falling back to the web, then web query rewrites
MAX_RETRIEVAL_REWRITES=1
MAX_WEB_REWRITES=1
# Previous turns used to understand follow-up questions
MEMORY_TURNS=4
# Max evidence size sent to the model
MAX_CONTEXT_CHARS=12000
